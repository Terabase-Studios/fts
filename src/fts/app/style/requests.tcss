#requests_label{
    width: 100%;
    height: 1;
    min-height: 1;
    content-align: center middle;
}

#requests_scroll {
    height: 1fr;
    width: 100%;
}

#requests_header {
    min-height: 4;
    height: 4;
}

Request {
    height: 12;
    border: hkey $panel-lighten-3;
    background: $boost 100%;
}

#request_button_bar{
    height: Auto;
    width: 100%;
}

#request_accept{
    width: 50%;
}

#request_deny{
    width: 50%;
}

#request_log{
    overflow-y: hidden;
    overflow-x: auto;
    height: 1fr;
    background: $surface-lighten-2 100%;
    padding: 1;
    outline: outer $surface-lighten-1;
    scrollbar-background: $surface;
}

#requests_container{
   background: $boost 0%;
}