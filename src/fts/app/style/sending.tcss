FileSelector {
    height: 5;
    min-height: 5;
    padding: 0 1 0 1;
    background: $surface;
}

#file_input {
    width: 1fr;
    height: Auto;
    background: $boost;
}

#browse_button {
    width: 10;
    min-width: 10%;
    margin-right: 1;
    height: Auto;
}

ContactSelector {
    width: 1fr;
    height: 5fr;
    padding: 0 2 2 2;
    background: $surface;
}

#contact_selection_list {
    width: 1fr;
    height: 1fr;
    border: hkey $secondary;
    background: $boost;
}

#sending_button_bar{
    width: 1fr;
    padding: 0 2 0 2
}

#select_all_button{
    width: 40%;
    min-width: 10%;
}

#deselect_all_button{
    width: 40%;
    min-width: 10%;
}

#file_send_button{
    width: 20%;
    min-width: 5%;
}